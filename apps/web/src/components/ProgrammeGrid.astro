<style>
  .grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 80px;
    grid-auto-rows: minmax(200px, auto);
    @apply flex-grow;
  }
  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(200px, auto);
    }
    .grid-cell.row-span-3 {
      grid-row: auto;
    }
    .grid-cell.col-span-2 {
      grid-column: auto;
    }
  }
  .grid-cell {
    border-right: 4px solid black;
    border-bottom: 4px solid black;
    padding: 1.5rem;
    transition: background-color 0.2s ease;
    @apply flex flex-col justify-between group border-r-0 md:border-r-4;
  }

  /* @media (max-width: 768px) {
    .grid-cell {
      border-right: 0px solid black;
    }
  } */

  .grid-cell__date {
    @apply font-mono text-xs uppercase mb-4 block opacity-70;
  }

  .grid-cell__artist {
    @apply text-3xl font-bold uppercase leading-none mb-2;
  }

  .grid-cell__artist--large {
    @apply text-5xl;
  }

  .grid-cell__description {
    @apply font-mono text-sm border-t border-black pt-2;
  }

  .grid-cell__time {
    @apply mt-8 text-2xl font-bold;
  }
  .grid-cell__time-live {
    @apply bg-primary text-white text-[10px] px-2 py-1 font-bold animate-pulse;
  }
  .grid-cell__time--large span {
    @apply text-3xl font-bold;
  }

  .grid-cell:hover {
    @apply bg-black text-primary;
  }

  .vertical-cell {
    border-bottom: 4px solid black;
    padding: 1.5rem;
    transition: background-color 0.2s ease;
    border-right: 0px solid black;
    @apply row-span-1 md:row-span-3 p-0 flex items-center justify-center text-primary bg-black;
  }

  .vertical-text {
    @apply text-5xl font-bold tracking-[0.2em] uppercase;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
  @media (max-width: 768px) {
    .vertical-text {
      writing-mode: horizontal-tb;
      text-orientation: initial;
    }
  }

  .grid-cell--image {
    @apply p-0 overflow-hidden;
    & img {
      @apply w-full h-full object-cover opacity-80;
    }
  }

  .grainy-img {
    filter: grayscale(100%) contrast(150%) brightness(80%);
  }
</style>
