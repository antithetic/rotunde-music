---
import Layout from '@/layouts/Layout.astro'
import Container from '@/components/Container.astro'
import Header from '@/components/Header.astro'
import Nav from '@/components/Nav.astro'
import WeeklyWine from '@/components/WeeklyWine.astro'
import ListeningNotes from '@/components/ListeningNotes.astro'
import UpcomingGuests from '@/components/UpcomingGuests.astro'
import Footer from '@/components/Footer.astro'
import '@/styles/global.css'
---

<Layout>
  <Container>
    <Header title="LA ROTONDE" />
    <!-- Main Content -->
    <main>
      <Nav />
      <!-- Intro Section -->
      <section class="intro">
        <p class="intro__text">
          Low intervention wines and high fidelity sound. A weekly dispatch from
          the intersection of fermentation and frequency.
        </p>
      </section>
      <WeeklyWine />
      <ListeningNotes />
      <UpcomingGuests />
      <Footer />
    </main>
  </Container>
</Layout>

<style>
  main {
    @apply flex flex-col;
  }

  .intro {
    @apply p-8 border-b-4 border-black;
  }

  .intro__text {
    @apply text-3xl font-display leading-tight max-w-2xl;
  }
</style>
