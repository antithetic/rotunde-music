---
import Layout from '@/layouts/Layout.astro'
import Container from '@/components/Container.astro'
import Header from '@/components/Header.astro'
import Nav from '@/components/Nav.astro'
import ProgrammeGrid from '@/components/ProgrammeGrid.astro'
import Footer from '@/components/Footer.astro'
import '@/styles/global.css'
---

<Layout>
  <Container>
    <Header title="ROTONDE" />
    <!-- Main Content -->
    <main>
      <Nav />
      <!-- Intro Section -->
      <section class="intro">
        <p class="intro__text">
          Weekly selectors, community events and gatherings.
          <!-- ROTONDE is a
          platform for music discovery and connection, where we share our love
          for music and create a space for people to come together and connect. -->
        </p>
      </section>
      <ProgrammeGrid />
      <Footer />
    </main>
  </Container>
</Layout>

<style>
  main {
    @apply flex flex-col;
  }

  .intro {
    @apply p-8 border-b-4 border-black;
  }

  .intro__text {
    @apply text-3xl font-display leading-tight max-w-2xl;
  }
</style>
